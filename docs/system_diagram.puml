@startuml
!theme plain

title 民國無雙 RTS - 系統架構圖

' 定義組件
package "Unreal Engine 5" {
  [GameMode] <<C++>>
  [PlayerController] <<C++>>
  [RTSUnit] <<C++>>
  [RTSBuilding] <<C++>>
  [ResourceManager] <<C++>>
  [AIController] <<C++>>
}

package "Blueprint Layer" {
  [UI Widgets] <<Blueprint>>
  [Gameplay Ability System] <<Blueprint>>
  [Behavior Tree] <<Blueprint>>
}

package "AI Tools" {
  [Stable Diffusion] <<Python>>
  [ControlNet] <<Python>>
  [AIVA API] <<REST>>
}

package "Data Layer" {
  [SaveGame] <<JSON>>
  [Config] <<INI>>
  [Asset Registry] <<Database>>
}

' 關係
GameMode --> PlayerController : "拥有"
GameMode --> ResourceManager : "管理"
PlayerController --> UI Widgets : "交互"
RTSUnit --> AIController : "AI控制"
RTSUnit --> Gameplay Ability System : "技能"
RTSBuilding --> ResourceManager : "生产"
AIController --> Behavior Tree : "决策"

' External integration
Stable Diffusion --> [RTSUnit] : "生成贴图"
ControlNet --> [RTSBuilding] : "生成图标"
AIVA API --> [GameMode] : "播放音乐"

@enduml