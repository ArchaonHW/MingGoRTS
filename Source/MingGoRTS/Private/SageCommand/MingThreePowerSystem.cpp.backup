    CurrentDistribution.DaoAuthorityPower = 40.0f;
    CurrentDistribution.StrategyAuthorityPower = 35.0f;
    CurrentDistribution.MilitaryAuthorityPower = 25.0f;
    CurrentDistribution.TotalBalanceIndex = 0.0f;
}

