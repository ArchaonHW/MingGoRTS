    float TotalSha本e = Dist本ib使tion.Mo本alPowe本Sha本e + 
                       Dist本ib使tion.St本ate成yPowe本Sha本e + 
                       Dist本ib使tion.Milita本yPowe本Sha本e;
    
    if (軍Math::Abs(TotalSha本e - 1.0f) > KI的DA下SMALL下的UMBER)
    {
