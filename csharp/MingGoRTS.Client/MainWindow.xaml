<Window x:Class="MingGoRTS.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="斷橋攻防戰 — MingGoRTS (C# 前端)"
        Width="1020" Height="680" Background="#FF101418">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="220"/>
        </Grid.ColumnDefinitions>

        <!-- 戰場畫布：世界 20×15 映射像素 -->
        <Canvas x:Name="Field" Grid.Column="0"
                Margin="12" Background="#FF1A2026"
                MouseLeftButtonDown="Field_LeftDown"
                MouseRightButtonDown="Field_RightDown"/>

        <!-- 右側 HUD -->
        <StackPanel Grid.Column="1" Margin="8">
            <TextBlock x:Name="HudPhase" Foreground="#FF35D0C5"
                       FontSize="16" FontWeight="Bold" Margin="0,8,0,4"/>
            <TextBlock x:Name="HudClock" Foreground="#FF9FB2BD" Margin="0,0,0,2"/>
            <TextBlock x:Name="HudCp" Foreground="#FFD4A23C" Margin="0,0,0,2"/>
            <TextBlock x:Name="HudIntel" Foreground="#FF9FB2BD" Margin="0,0,0,10"/>

            <TextBlock Text="指令" Foreground="#FF9FB2BD" FontSize="12"/>
            <TextBlock Text="LMB 選取我方小隊&#x0a;RMB 攻擊移動至目標&#x0a;點雲=探測(1情報)&#x0a;Space 暫停 / 1·2·3 速度"
                       Foreground="#FF6E7B85" FontSize="11"
                       TextWrapping="Wrap" Margin="0,0,0,10"/>

            <Button x:Name="BtnPause" Content="暫 停" Click="BtnPause_Click"
                    Margin="0,0,0,4" Padding="6,4"/>
            <Button x:Name="BtnSpeed" Content="速度 ×1" Click="BtnSpeed_Click"
                    Margin="0,0,0,10" Padding="6,4"/>

            <TextBlock x:Name="HudSelected" Foreground="#FF9FB2BD"
                       FontSize="12" TextWrapping="Wrap"/>
            <TextBlock x:Name="HudOutcome" Foreground="#FFD4A23C"
                       FontSize="15" FontWeight="Bold"
                       TextWrapping="Wrap" Margin="0,8,0,0"/>
        </StackPanel>
    </Grid>
</Window>
