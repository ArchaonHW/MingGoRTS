+            std::max_element(cloud.begin(), cloud.end(),
+                             [](const auto& a, const auto& b) {
+                                 return a.second < b.second;
+                             })->first;
+        const float d = (modal - squad.GetPosition()).Length();
+        if (d < bestDist) {
+            bestDist = d;
+            out = modal;
+            found = true;
+        }
+    }
+    return found;
+}
