#!/usr/bin/env pwsh

<#
.SYNOPSIS
    智能工作流選擇器

.DESCRIPTION
    根據專案狀態自動選擇最適合的工作流程

.PARAMETER Auto
    啟動自動化模式，持續監控並執行最佳工作流

.PARAMETER Manual
    手動選擇工作流

.PARAMETER QuickFix
    快速修復模式 - 自動執行所有必要的修復工作流

.PARAMETER ProjectRoot
    專案根目錄路徑

.PARAMETER ScanInterval
    自動模式下掃描間隔（秒）

.EXAMPLE
    .\SmartWorkflowSelector.ps1 -Auto
    .\SmartWorkflowSelector.ps1 -Manual
    .\SmartWorkflowSelector.ps1 -QuickFix
#>

param(
    [switch]$Auto,
    [switch]$Manual,
    [switch]$QuickFix,
    [string]$ProjectRoot = "$PSScriptRoot/../..",
    [int]$ScanInterval = 60
)

# 全局配置
$script:Config = @{
    ProjectRoot = $ProjectRoot
    WorkflowDir = "$PSScriptRoot/../../.windsurf/workflows"
    LogDir = "$PSScriptRoot/../../Logs"
    LastRunFile = "$PSScriptRoot/../../Logs/.last_workflow_run"
}

# 工作流優先級配置
$script:WorkflowPriority = @(
    @{ Name = "編譯修復"; Pattern = "compile-fix|syntax-check"; Priority = 1; Threshold = 10 }
    @{ Name = "編碼修復"; Pattern = "encoding-fix"; Priority = 2; Threshold = 5 }
    @{ Name = "內存洩漏修復"; Pattern = "memory-fix|leak-fix"; Priority = 3; Threshold = 3 }
    @{ Name = "性能優化"; Pattern = "optimize|performance"; Priority = 4; Threshold = 2 }
    @{ Name = "文檔生成"; Pattern = "docs|documentation"; Priority = 5; Threshold = 1 }
)

# 日誌函數
function Write-WorkflowLog {
    param(
        [string]$Message,
        [string]$Level = "INFO"
    )
    
    $timestamp = Get-Date -Format "yyyy-MM-dd HH:mm:ss"
    $logEntry = "[$timestamp] [$Level] $Message"
    
    # 確保日誌目錄存在
    if (-not (Test-Path $script:Config.LogDir)) {
        New-Item -ItemType Directory -Path $script:Config.LogDir -Force | Out-Null
    }
    
    $logFile = Join-Path $script:Config.LogDir "workflow_$(Get-Date -Format 'yyyyMMdd').log"
    Add-Content -Path $logFile -Value $logEntry
    
    # 控制台輸出顏色
    $colorMap = @{
        "INFO" = "White"
        "SUCCESS" = "Green"
        "WARNING" = "Yellow"
        "ERROR" = "Red"
    }
    
    Write-Host $logEntry -ForegroundColor $colorMap[$Level]
}

function Get-ProjectStatus {
    Write-WorkflowLog "正在分析專案狀態..." "INFO"
    
    $status = @{
        CompileErrors = 0
        EncodingIssues = 0
        MemoryLeaks = 0
        PerformanceIssues = 0
        LastWorkflow = $null
    }
    
    # 檢查編譯錯誤（通過檢查報告文件）
    $compileReport = Join-Path $ProjectRoot "Reports/BMAD_Import_Report_*.md"
    $compileFiles = Get-ChildItem -Path $compileReport -ErrorAction SilentlyContinue
    if ($compileFiles) {
        $latestReport = $compileFiles | Sort-Object LastWriteTime -Descending | Select-Object -First 1
        $content = Get-Content $latestReport.FullName -Raw
        if ($content -match "語法錯誤[:\s]+(\d+)") {
            $status.CompileErrors = [int]$Matches[1]
        }
    }
    
    # 檢查上次執行的工作流
    if (Test-Path $script:Config.LastRunFile) {
        $status.LastWorkflow = Get-Content $script:Config.LastRunFile -Raw
    }
    
    Write-WorkflowLog "專案狀態分析完成：編譯錯誤 $($status.CompileErrors)" "INFO"
    return $status
}

function Select-BestWorkflow {
    param([hashtable]$Status)
    
    Write-WorkflowLog "正在選擇最佳工作流..." "INFO"
    
    # 根據狀態選擇工作流
    if ($Status.CompileErrors -gt $script:WorkflowPriority[0].Threshold) {
        return $script:WorkflowPriority[0]
    }
    
    if ($Status.EncodingIssues -gt $script:WorkflowPriority[1].Threshold) {
        return $script:WorkflowPriority[1]
    }
    
    if ($Status.MemoryLeaks -gt $script:WorkflowPriority[2].Threshold) {
        return $script:WorkflowPriority[2]
    }
    
    # 預設選擇優先級最低的工作流
    return $script:WorkflowPriority[-1]
}

function Execute-Workflow {
    param([hashtable]$Workflow)
    
    Write-WorkflowLog "執行工作流: $($Workflow.Name)" "INFO"
    
    # 查找匹配的工作流文件
    $workflowFiles = Get-ChildItem -Path $script:Config.WorkflowDir -Filter "*.md" -ErrorAction SilentlyContinue |
        Where-Object { $_.Name -match $Workflow.Pattern }
    
    if (-not $workflowFiles) {
        Write-WorkflowLog "未找到匹配的工作流文件" "WARNING"
        return $false
    }
    
    # 執行找到的工作流（這裡僅記錄，實際執行需要更多邏輯）
    foreach ($file in $workflowFiles) {
        Write-WorkflowLog "發現工作流文件: $($file.Name)" "INFO"
    }
    
    # 記錄本次執行
    Set-Content -Path $script:Config.LastRunFile -Value $Workflow.Name
    
    return $true
}

function Show-WorkflowMenu {
    Write-Host "`n=== 智能工作流選擇器 ===" -ForegroundColor Cyan
    Write-Host "請選擇要執行的工作流:`n" -ForegroundColor White
    
    for ($i = 0; $i -lt $script:WorkflowPriority.Count; $i++) {
        Write-Host "  $($i + 1). $($script:WorkflowPriority[$i].Name)" -ForegroundColor Yellow
    }
    
    Write-Host "  Q. 退出" -ForegroundColor Red
    Write-Host ""
    
    $choice = Read-Host "請輸入選項"
    
    if ($choice -eq 'Q' -or $choice -eq 'q') {
        return $null
    }
    
    $index = [int]$choice - 1
    if ($index -ge 0 -and $index -lt $script:WorkflowPriority.Count) {
        return $script:WorkflowPriority[$index]
    }
    
    Write-Host "無效選項" -ForegroundColor Red
    return $null
}

function Start-AutoMode {
    Write-WorkflowLog "啟動自動模式（掃描間隔: $ScanInterval 秒）" "INFO"
    
    try {
        while ($true) {
            $status = Get-ProjectStatus
            $workflow = Select-BestWorkflow -Status $status
            
            if ($workflow) {
                $result = Execute-Workflow -Workflow $workflow
                if ($result) {
                    Write-WorkflowLog "工作流執行成功: $($workflow.Name)" "SUCCESS"
                } else {
                    Write-WorkflowLog "工作流執行失敗: $($workflow.Name)" "ERROR"
                }
            }
            
            Write-WorkflowLog "等待下次掃描..." "INFO"
            Start-Sleep -Seconds $ScanInterval
        }
    }
    catch {
        Write-WorkflowLog "自動模式異常退出: $_" "ERROR"
    }
}

function Start-QuickFixMode {
    Write-WorkflowLog "啟動快速修復模式" "INFO"
    
    # 按優先級執行所有需要的工作流
    $status = Get-ProjectStatus
    
    foreach ($workflow in $script:WorkflowPriority) {
        $shouldRun = $false
        
        switch ($workflow.Name) {
            "編譯修復" { if ($status.CompileErrors -gt 0) { $shouldRun = $true } }
            "編碼修復" { if ($status.EncodingIssues -gt 0) { $shouldRun = $true } }
            "內存洩漏修復" { if ($status.MemoryLeaks -gt 0) { $shouldRun = $true } }
            default { $shouldRun = $true }
        }
        
        if ($shouldRun) {
            Write-WorkflowLog "執行修復工作流: $($workflow.Name)" "INFO"
            Execute-Workflow -Workflow $workflow
        }
    }
    
    Write-WorkflowLog "快速修復模式完成" "SUCCESS"
}

# 主程序
Write-WorkflowLog "智能工作流選擇器啟動" "INFO"

if ($QuickFix) {
    Start-QuickFixMode
}
elseif ($Auto) {
    Start-AutoMode
}
elseif ($Manual) {
    $selectedWorkflow = Show-WorkflowMenu
    if ($selectedWorkflow) {
        Execute-Workflow -Workflow $selectedWorkflow
    }
}
else {
    # 預設行為：顯示狀態並建議最佳工作流
    $status = Get-ProjectStatus
    $bestWorkflow = Select-BestWorkflow -Status $status
    
    Write-Host "`n=== 專案狀態摘要 ===" -ForegroundColor Cyan
    Write-Host "編譯錯誤: $($status.CompileErrors)" -ForegroundColor $(if ($status.CompileErrors -gt 0) { "Red" } else { "Green" })
    Write-Host "編碼問題: $($status.EncodingIssues)" -ForegroundColor $(if ($status.EncodingIssues -gt 0) { "Yellow" } else { "Green" })
    Write-Host "內存洩漏: $($status.MemoryLeaks)" -ForegroundColor $(if ($status.MemoryLeaks -gt 0) { "Red" } else { "Green" })
    Write-Host "`n建議執行工作流: $($bestWorkflow.Name)" -ForegroundColor Cyan
    Write-Host "`n使用 -Auto 啟動自動模式" -ForegroundColor White
    Write-Host "使用 -Manual 手動選擇工作流" -ForegroundColor White
    Write-Host "使用 -QuickFix 執行所有必要修復" -ForegroundColor White
}

Write-WorkflowLog "智能工作流選擇器結束" "INFO"
